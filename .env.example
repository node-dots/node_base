# Локальний сервер. HTTP-параметри мають defaults; MONGO_URI потрібно задати.
HOST=127.0.0.1
PORT=3000

# HTTP-захист. Нуль не вимикає обмеження; некоректні значення зупиняють запуск.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_REQUESTS=300
WRITE_RATE_LIMIT_REQUESTS=30
JSON_BODY_LIMIT_BYTES=32768
HEADERS_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=30000
SOCKET_IDLE_TIMEOUT_MS=30000
KEEP_ALIVE_TIMEOUT_MS=5000

# Локальний tracing. Без .env він вимкнений; Jaeger приймає лише traces.
TELEMETRY_ENABLED=true
# Показ входів/результатів тільки для development. Секретні поля маскуються.
NODE_ENV=development
TELEMETRY_DEBUG_DATA=true
OTEL_SERVICE_NAME=kindergarten-backend
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Локальна база даних.
MONGO_URI=mongodb://127.0.0.1:27017/kindergarten_dev?replicaSet=rs0&directConnection=true

# Authentication. Generate a private random secret of at least 32 UTF-8 bytes.
JWT_SECRET=
JWT_ISSUER=http://127.0.0.1:3000
JWT_AUDIENCE=kindergarten-backend

# Initial administrator. Required only for `npm run bootstrap:admin`.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
